{
  "cli": {
    "version": ">= 19.0.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "ios": {
        "autoIncrement": "buildNumber"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      }
    },
    "testflight": {
      "ios": {
        "simulator": false,
        "autoIncrement": "buildNumber"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6760843217",
        "appleTeamId": "U45N6GLUV2"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6760843217",
        "appleTeamId": "U45N6GLUV2"
      }
    }
  }
}
