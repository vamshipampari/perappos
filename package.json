{
  "name": "cottix",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx}\" --ignore-path .gitignore",
    "build:ios:testflight": "eas build --platform ios --profile testflight",
    "submit:ios:testflight": "eas submit --platform ios --profile testflight",
    "submit:android:beta": "eas submit --platform android --profile beta",
    "submit:android:production": "eas submit --platform android --profile production",
    "deploy": "npx expo export -p web && wrangler deploy",
    "preview": "npx expo export -p web && wrangler dev"
  },
  "dependencies": {
    "@azure/core-asynciterator-polyfill": "^1.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@journeyapps/react-native-quick-sqlite": "^2.5.1",
    "@powersync/react-native": "^1.31.0",
    "@react-navigation/native": "^7.1.28",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.98.0",
    "expo": "~55.0.4",
    "expo-constants": "~55.0.9",
    "expo-crypto": "~55.0.10",
    "expo-dev-client": "~55.0.18",
    "expo-document-picker": "~55.0.9",
    "expo-file-system": "~55.0.11",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.9",
    "expo-image-picker": "~55.0.13",
    "expo-linking": "~55.0.8",
    "expo-local-authentication": "~55.0.9",
    "expo-notifications": "~55.0.13",
    "expo-router": "~55.0.7",
    "expo-secure-store": "~55.0.9",
    "expo-sharing": "~55.0.14",
    "expo-splash-screen": "~55.0.12",
    "expo-sqlite": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.10",
    "expo-web-browser": "~55.0.10",
    "jszip": "^3.10.1",
    "nativewind": "^4.2.2",
    "posthog-react-native": "^4.39.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-purchases": "^10.0.1",
    "react-native-purchases-ui": "^10.0.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@babel/plugin-transform-async-generator-functions": "^7.29.0",
    "@types/jest": "^30.0.0",
    "@types/jszip": "^3.4.1",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-jest": "^30.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "4",
    "jest": "^30.3.0",
    "node-addon-api": "^8.7.0",
    "node-gyp": "^12.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "wrangler": "^4.82.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest",
        "babel-jest"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@journeyapps/react-native-quick-sqlite"
        ]
      }
    }
  },
  "private": true,
  "packageManager": "npm"
}
